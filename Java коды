import java.util.*;

public class SortingVisualization {

    // Массивті шығару
    public static void printArray(int[] arr) {
        System.out.println(Arrays.toString(arr));
    }

    // Bubble Sort
    public static void bubbleSort(int[] arr) {
        System.out.println("\nBubble Sort:");
        int n = arr.length;

        for (int i = 0; i < n - 1; i++) {
            System.out.println("Қадам " + (i + 1) + ":");
            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    // ауыстыру
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
                printArray(arr);
            }
        }
    }

    // Selection Sort
    public static void selectionSort(int[] arr) {
        System.out.println("\nSelection Sort:");
        int n = arr.length;

        for (int i = 0; i < n - 1; i++) {
            int minIndex = i;

            for (int j = i + 1; j < n; j++) {
                if (arr[j] < arr[minIndex]) {
                    minIndex = j;
                }
            }

            // ауыстыру
            int temp = arr[minIndex];
            arr[minIndex] = arr[i];
            arr[i] = temp;

            System.out.print("Қадам " + (i + 1) + ": ");
            printArray(arr);
        }
    }

    public static void main(String[] args) {

        int[] array1 = {5, 3, 8, 4, 2};
        int[] array2 = {5, 3, 8, 4, 2};

        bubbleSort(array1);
        selectionSort(array2);
    }
}
